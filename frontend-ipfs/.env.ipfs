# Build target: dmpay.eth via IPFS gateways.
# Hash routing is required — gateways serve a hard 404 for any path that isn't a real file.
VITE_PUBLIC_URL=https://dmpay.eth.link
VITE_CLEAN_URLS=false

# Shared links point at the Pages host: gateway URLs are hash-routed, and a
# hash never reaches a server, so no crawler can render a preview for one.
VITE_SHARE_URL=https://app.dmpay.me

# NFT picker proxy — Pages-only, since it holds the OpenSea key server-side.
# Browsing your NFTs needs this host; sending one never does.
VITE_API_URL=https://app.dmpay.me
