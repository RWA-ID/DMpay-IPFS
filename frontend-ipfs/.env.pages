# Build target: app.dmpay.me on Cloudflare Pages.
# Clean paths work here because public/_redirects rewrites unknown paths to index.html.
VITE_PUBLIC_URL=https://app.dmpay.me
VITE_CLEAN_URLS=true

# Same origin here, but stated explicitly so the two roles stay distinct.
VITE_SHARE_URL=https://app.dmpay.me

# NFT picker proxy. Same origin here; stated so the IPFS build's cross-origin
# call to the same endpoint is an explicit config value, not a hidden default.
VITE_API_URL=https://app.dmpay.me
